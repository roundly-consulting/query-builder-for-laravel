        "kind": {
            "column": "status",
            "operators": [],
            "shape": "text",
            "nullable": false
        },
        "title": {
            "column": "title",
            "operators": [
                "contains",
                "ncontains",
                "starts"
            ],
            "shape": "text",
            "nullable": false
        },
        "note": {
