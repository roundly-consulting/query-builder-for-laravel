{
    "name": "roundly-consulting/query-builder-for-laravel",
    "description": "Native, allow-list-driven filter, sort and pagination for Laravel API list endpoints",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "query-builder",
        "filter",
        "sort",
        "pagination"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/query-builder-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/query-builder-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "symfony/http-kernel": "^7.2|^8.0",
        "roundly-consulting/enums-for-laravel": "^1.0",
        "roundly-consulting/package-toolkit-for-laravel": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "roundly-consulting/testing-for-laravel": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\QueryBuilder\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\QueryBuilder\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=95"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\QueryBuilder\\QueryBuilderServiceProvider"
            ]
        }
    }
}
